---
import { categoryHref, getCategories } from '../lib/articles';

const categories = await getCategories();
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href="/">阅读收藏</a>
    <nav class="site-nav" aria-label="分类">
      <a href="/articles/" aria-current={currentPath === '/articles/' ? 'page' : undefined}>
        全部文章
      </a>
      {
        categories.map((cat) => {
          const href = categoryHref(cat.name);
          const articlePrefix = `/article/${encodeURIComponent(cat.name)}/`;
          const current =
            currentPath === href ||
            currentPath === href.slice(0, -1) ||
            currentPath.startsWith(articlePrefix);
          return (
            <a href={href} aria-current={current ? 'page' : undefined}>
              {cat.name}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
