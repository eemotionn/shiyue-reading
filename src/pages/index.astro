---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories } from '../lib/articles';

const categories = await getCategories();
---

<BaseLayout title="阅读收藏" description="按分类浏览想读的文章，国外文可切换原文与译文。">
  <h1 class="page-title">阅读收藏</h1>
  <p class="page-lead">
    按分类收纳想读的文章。国外文章提供原文与中文译文，可在阅读页一键切换；国内文章仅保留中文版。
  </p>

  {
    categories.length === 0 ? (
      <p class="empty">还没有分类。在 <code>src/content/articles/</code> 下添加 Markdown 即可。</p>
    ) : (
      <ul class="card-grid">
        {categories.map((cat) => (
          <li>
            <a class="card" href={`/category/${cat.name}/`}>
              <h2 class="card__title">{cat.name}</h2>
              <p class="card__meta">{cat.count} 篇</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
